# Install ZInit
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"

# ZInit configuration
zinit load zdharma-continuum/history-search-multi-word
zinit light zsh-users/zsh-autosuggestions
zinit light zdharma-continuum/fast-syntax-highlighting

zi for \
    atload"zicompinit; zicdreplay" \
    blockf \
    lucid \
    wait \
  zsh-users/zsh-completions

{{ if eq .chezmoi.os "darwin" -}}
# Rbenv
_rbenv_bin="${HOMEBREW_PREFIX:-/opt/homebrew}/bin/rbenv"
_rbenv_cache="${XDG_CACHE_HOME:-$HOME/.cache}/rbenv/init.zsh"

if [[ ! -s "$_rbenv_cache" || "$_rbenv_bin" -nt "$_rbenv_cache" ]]; then
  mkdir -p "${_rbenv_cache:h}"

  _rbenv_cache_tmp="${_rbenv_cache}.$$"
  if "$_rbenv_bin" init - --no-rehash zsh >| "$_rbenv_cache_tmp"; then
    command mv -f "$_rbenv_cache_tmp" "$_rbenv_cache"
  else
    command rm -f "$_rbenv_cache_tmp"
  fi
  unset _rbenv_cache_tmp
fi

[[ -r "$_rbenv_cache" ]] && source "$_rbenv_cache"
unset _rbenv_bin _rbenv_cache

# 1password Socket
export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
{{- end }}

export PATH="/usr/local/sbin:/usr/local/bin:$PATH"
export PATH="${HOME}/go/bin:$PATH"
export PATH="/usr/local/opt/go@1/bin:$PATH"
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export SDKROOT=$(xcrun --sdk macosx --show-sdk-path)

{{ if .codespaces -}}
export PATH="/workspaces/.local/bin:~/.local/bin:$PATH"
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
# Autoenv loads first so its initial scan does not trigger zoxide hooks.
source /opt/homebrew/opt/autoenv/activate.sh
{{- end }}

eval "$(zoxide init zsh)"

if [ "$TERM_PROGRAM" != "Apple_Terminal" ]; then
  eval "$(oh-my-posh init zsh --config ~/.config/omp/config.omp.json)"
fi

export GPG_TTY=$(tty)

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

{{ if eq .chezmoi.os "darwin" -}}
source /Users/omgitsads/.config/op/plugins.sh
{{- end }}

# ZSH history
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase

setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# Neovim
alias vim="nvim"
alias vi="nvim"

# Shell command customization
alias ls='eza --color=always --group-directories-first --icons=auto'
alias cat=bat
